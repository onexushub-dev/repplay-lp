---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../layouts/base-layout.astro';
import { useTranslations } from '../i18n/ui';

const t = useTranslations('pt-BR');
---

<BaseLayout locale="pt-BR" title={`${t('notFound.title')} | Repplay`} description={t('notFound.body')} noindex>
  <section class="mx-auto flex min-h-[60vh] max-w-3xl flex-col items-start justify-center gap-5 px-4 py-24 sm:px-6">
    <p class="text-lima text-sm font-bold tracking-widest uppercase">404</p>
    <h1 class="text-5xl font-extrabold sm:text-6xl">{t('notFound.title')}</h1>
    <p class="text-muted text-lg">{t('notFound.body')}</p>
    <a href={getRelativeLocaleUrl('pt-BR', '')} class="bg-lima text-ink rounded-xl px-5 py-3 font-bold no-underline">
      {t('legal.backHome')}
    </a>
  </section>
</BaseLayout>
