---
import { Font } from 'astro:assets';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import '../styles/global.css';
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';
import { locales, useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Path of the page without the locale prefix: '' for the home page, 'privacy' for /privacy and /en/privacy. */
  slug?: string;
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
  /** Structured data (schema.org) written into the head as JSON-LD. */
  jsonLd?: Record<string, unknown>[];
  /** Image that paints first (the hero poster), preloaded so the largest paint does not wait for the video. */
  preloadImage?: string;
}

const { locale, title, description, slug = '', noindex = false, jsonLd = [], preloadImage } = Astro.props;
const t = useTranslations(locale);

const canonical = getAbsoluteLocaleUrl(locale, slug);
const alternates = locales.map((l) => ({ locale: l, href: getAbsoluteLocaleUrl(l, slug) }));
const ogImage = new URL('/og-1200x630-escuro.png', Astro.site).href;
const ogLocale = { 'pt-BR': 'pt_BR', en: 'en_US', es: 'es_LA' }[locale];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.locale} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('pt-BR', slug)} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#0A0A0A" />
    <meta name="theme-color" content="#0A0A0A" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('meta.siteName')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('meta.ogImageAlt')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t('meta.ogImageAlt')} />

    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <Font cssVariable="--font-barlow" preload />
    <Font cssVariable="--font-manrope" preload />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a
      href="#main"
      class="bg-amber text-ink sr-only rounded-lg px-4 py-2 font-bold focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
    >
      {t('a11y.skip')}
    </a>
    <Header locale={locale} slug={slug} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
