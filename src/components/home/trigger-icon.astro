---
import type { TriggerKey } from '../../i18n/home';

interface Props {
  name: TriggerKey;
}

const { name } = Astro.props;
---

<svg
  class="tile__icon"
  viewBox="0 0 64 64"
  fill="none"
  stroke="currentColor"
  stroke-width="2.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'tap' && (
      <>
        <rect x="17" y="5" width="30" height="54" rx="7"></rect>
        <path d="M28 10h8"></path>
        <circle class="ic-ripple" cx="32" cy="34" r="11" style="animation-delay:0s"></circle>
        <circle class="ic-ripple" cx="32" cy="34" r="11" style="animation-delay:.9s"></circle>
        <circle class="ic-pulse" cx="32" cy="34" r="4.5" fill="currentColor" stroke="none"></circle>
      </>
    )
  }
  {
    name === 'gesture' && (
      <>
        <circle cx="32" cy="16" r="5.5"></circle>
        <path d="M32 22v20M32 42l-7 14M32 42l7 14"></path>
        <path class="ic-arm ic-arm--l" d="M26 30l-8 12"></path>
        <path class="ic-arm ic-arm--r" d="M38 30l8 12"></path>
      </>
    )
  }
  {
    name === 'voice' && (
      <>
        {[14, 22, 30, 38, 46].map((x, i) => (
          <line
            class="ic-bar"
            x1={x}
            x2={x}
            y1="18"
            y2="46"
            style={`animation-delay:${i * 0.14}s`}
          ></line>
        ))}
      </>
    )
  }
  {
    name === 'watch' && (
      <>
        <path d="M24 8h16l2 10H22ZM22 46h20l-2 10H24Z"></path>
        <rect x="18" y="18" width="28" height="28" rx="8" fill="#0b0b09"></rect>
        <circle class="ic-pulse" cx="32" cy="32" r="6.5" fill="currentColor" stroke="none"></circle>
        <path class="ic-signal" d="M8 26c-3 4-3 8 0 12M56 26c3 4 3 8 0 12" style="animation-delay:.2s"></path>
      </>
    )
  }
  {
    name === 'bluetooth' && (
      <>
        <rect x="22" y="10" width="20" height="44" rx="10"></rect>
        <circle class="ic-pulse" cx="32" cy="26" r="5" fill="currentColor" stroke="none"></circle>
        <path d="M28 40h8"></path>
        <path class="ic-signal" d="M12 22c-3 6-3 14 0 20M52 22c3 6 3 14 0 20"></path>
        <path class="ic-signal" d="M6 16c-5 9-5 23 0 32M58 16c5 9 5 23 0 32" style="animation-delay:.35s"></path>
      </>
    )
  }
  {
    name === 'phone' && (
      <>
        <rect x="6" y="14" width="22" height="38" rx="5"></rect>
        <rect x="36" y="14" width="22" height="38" rx="5"></rect>
        <path d="M17 46h0M47 46h0"></path>
        <path class="ic-signal" d="M30 30h4" stroke-dasharray="1 3"></path>
        <circle class="ic-pulse" cx="47" cy="28" r="5" fill="currentColor" stroke="none"></circle>
      </>
    )
  }
</svg>
