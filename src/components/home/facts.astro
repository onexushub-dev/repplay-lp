---
import { homeCopy } from '../../i18n/home';
import type { Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const facts = homeCopy[locale].facts;
---

<section aria-label="Revi" class="border-line bg-surface/40 border-y">
  <ul class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-10 gap-y-3 px-4 py-5 sm:px-6">
    {
      facts.map((fact) => (
        <li class="flex items-center gap-3 text-sm font-bold tracking-[0.14em] uppercase sm:text-base">
          <span class="bg-amber size-2 rounded-full" aria-hidden="true" />
          {fact}
        </li>
      ))
    }
  </ul>
</section>
