---
import '../styles/home.css';
import BaseLayout from '../layouts/base-layout.astro';
import Hero from './home/hero.astro';
import Facts from './home/facts.astro';
import HowItWorks from './home/how-it-works.astro';
import Triggers from './home/triggers.astro';
import Editor from './home/editor.astro';
import Privacy from './home/privacy.astro';
import Sports from './home/sports.astro';
import Testimonials from './home/testimonials.astro';
import Plans from './home/plans.astro';
import Faq from './home/faq.astro';
import FinalCta from './home/final-cta.astro';
import StickyCta from './home/sticky-cta.astro';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { homeCopy } from '../i18n/home';
import { SUPPORT_EMAIL, useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const site = Astro.site!.origin;
const pageUrl = getAbsoluteLocaleUrl(locale, '');
const publisher = {
  '@type': 'Organization',
  '@id': `${site}/#organization`,
  name: 'Revi',
  url: site,
  logo: `${site}/icon-512.png`,
  contactPoint: { '@type': 'ContactPoint', email: SUPPORT_EMAIL, contactType: 'customer support' },
};
const jsonLd = [
  { '@context': 'https://schema.org', ...publisher },
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: 'Revi',
    url: pageUrl,
    description: t('meta.homeDescription'),
    inLanguage: locale,
    applicationCategory: 'SportsApplication',
    operatingSystem: 'iOS, Android',
    offers: { '@type': 'Offer', price: '0', priceCurrency: locale === 'pt-BR' ? 'BRL' : 'USD' },
    publisher: { '@id': publisher['@id'] },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: locale,
    mainEntity: homeCopy[locale].faq.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<BaseLayout
  locale={locale}
  title={t('meta.homeTitle')}
  description={t('meta.homeDescription')}
  jsonLd={jsonLd}
  preloadImage="/media/beach-tennis-hero.webp"
>
  <Hero locale={locale} />
  <Facts locale={locale} />
  <HowItWorks locale={locale} />
  <Triggers locale={locale} />
  <Editor locale={locale} />
  <Privacy locale={locale} />
  <Sports locale={locale} />
  <Testimonials locale={locale} />
  <Plans locale={locale} />
  <Faq locale={locale} />
  <FinalCta locale={locale} />
  <StickyCta locale={locale} />
</BaseLayout>
